{
	"compileOnSave": true,
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2019",
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"types": ["node", "markdown-it"],
		"esModuleInterop": true
	},
	"exclude": [
		"node_modules"
	]
}