{
  "name": "template",
  "version": "1.0.0",
  "description": "Dashboard app",
  "main": "app.js",
  "scripts": {
    "watch:sass": "sass scss/critical.scss assets/css/style.critical.css && sass scss/non-critical.scss assets/css/style.non-critical.css --watch",
    "devserver": "node .",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass:critical": "sass scss/critical.scss assets/css/style.critical.comp.css",
    "compile:sass:non-critical": "sass scss/non-critical.scss assets/css/style.non-critical.comp.css",
    "concat:css:critical": "concat -o assets/css/style.critical.concat.css assets/css/style.critical.comp.css",
    "concat:css:non-critical": "concat -o assets/css/style.non-critical.concat.css assets/css/style.non-critical.comp.css",
    "prefix:css:critical": "postcss --use autoprefixer -b 'last 10 versions' assets/css/style.critical.concat.css -o assets/css/style.critical.prefix.css",
    "prefix:css:non-critical": "postcss --use autoprefixer -b 'last 10 versions' assets/css/style.non-critical.concat.css -o assets/css/style.non-critical.prefix.css",
    "compress:css:critical": "sass assets/css/style.critical.prefix.css assets/css/style.critical.min.css --style=compressed --no-source-map",
    "compress:css:non-critical": "sass assets/css/style.non-critical.prefix.css assets/css/style.non-critical.min.css --style=compressed --no-source-map",
    "build:css": "npm-run-all compile:sass:critical compile:sass:non-critical concat:css:critical concat:css:non-critical prefix:css:critical prefix:css:non-critical compress:css:critical compress:css:non-critical",
    "build": "npm i && npm-run-all compile:sass:critical compile:sass:non-critical concat:css:critical concat:css:non-critical prefix:css:critical prefix:css:non-critical compress:css:critical compress:css:non-critical && tsc -p tsconfig.json && npm run clean",
    "build:railway": "npm-run-all compile:sass:critical compile:sass:non-critical concat:css:critical concat:css:non-critical prefix:css:critical prefix:css:non-critical compress:css:critical compress:css:non-critical",
    "clean": "rm -rf node_modules"
  },
  "author": "Dwayne",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/markdown-it": "^0.0.9",
    "@types/node": "^14.0.13",
    "@types/nodemailer": "^6.4.0",
    "@types/superagent": "^4.1.7",
    "concat": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "canvas": "^3.2.3",
    "compression": "^1.7.4",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "gray-matter": "^4.0.2",
    "he": "^1.2.0",
    "helmet": "^3.23.1",
    "markdown-it": "^12.3.2",
    "markdown-it-abbr": "^1.0.4",
    "markdown-it-emoji": "^1.4.0",
    "markdown-it-modify-token": "^1.0.2",
    "markdown-it-task-checkbox": "^1.0.6",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "resend": "^6.12.3",
    "superagent": "^5.2.2",
    "typescript": "^3.7.4",
    "webp-converter": "^2.2.3"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "IE 10"
  ]
}
