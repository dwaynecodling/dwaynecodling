<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Thoughts, insights and reflections from Dwayne Codling — Development Director and people-first leader.">
    <meta property="og:title" content="My Posts — Dwayne Codling" />
    <meta property="og:description" content="Thoughts, insights and reflections from Dwayne Codling — Development Director and people-first leader." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/pages/dwayne-profile.jpg" />
    <title>My Posts — Dwayne Codling</title>
    <%- include("../partials/links") %>
</head>
<body>
<%- include("../partials/nav") %>

<main class="content" role="main">

    <!-- Page Header -->
    <section style="margin-bottom:0;">
        <div style="
            background-image: linear-gradient(to right, rgba(13,26,16,0.97) 0%, rgba(13,26,16,0.6) 100%), url('/assets/img/pages/hero-posts.jpg');
            background-size: cover;
            background-position: center 37%;
            border-bottom: 1px solid rgba(200,133,58,0.15);
            padding: 10rem 0 8rem;
        ">
            <div class="container">
                <p style="font-size:1.2rem; font-weight:600; text-transform:uppercase; letter-spacing:0.2em; color:#c8853a; margin-bottom:1.6rem;">Writing</p>
                <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:var(--heading-1); font-weight:700; color:#f4ede0; line-height:1.15; max-width:56rem; margin-bottom:1.6rem;">
                    Thoughts &amp; <strong style="color:#c8853a;">reflections</strong>
                </h1>
                <p style="font-size:1.7rem; line-height:3rem; color:#a89e90; max-width:52rem;">
                    Leadership, diversity, tech, and the occasional life lesson from the platform.
                </p>
            </div>
        </div>
    </section>

    <!-- Filter + Posts -->
    <section class="card-wrapper" style="padding-top: 5rem;">
        <div class="container">

            <!-- Mobile filter -->
            <div class="my-posts__filter my-posts__filter--mobile">
                <label class="my-posts__filter--label" for="category-select">Filter by</label>
                <select class="my-posts__select" id="category-select">
                    <option value="all">All posts</option>
                    <option value="leadership">Leadership</option>
                    <option value="fitness">Fitness</option>
                    <option value="personal">Personal</option>
                    <option value="tech">Tech</option>
                </select>
            </div>

            <!-- Desktop filter tabs -->
            <ul class="my-posts__filter--desktop" role="tablist">
                <li class="my-posts__item my-posts__item--active" data-filter="all" role="tab" tabindex="0">All</li>
                <li class="my-posts__item" data-filter="leadership" role="tab" tabindex="0">Leadership</li>
                <li class="my-posts__item" data-filter="fitness" role="tab" tabindex="0">Fitness</li>
                <li class="my-posts__item" data-filter="personal" role="tab" tabindex="0">Personal</li>
                <li class="my-posts__item" data-filter="tech" role="tab" tabindex="0">Tech</li>
            </ul>

            <!-- Cards grid -->
            <article class="grid grid--card-list">
                <% for (let currentArticle of posts){ %>
                    <article class="grid__card-item" data-category="<%= currentArticle.data.category || 'all' %>">
                        <a href="/post/<%= currentArticle.data.slug %>" class="card">
                            <picture class="card__img-container">
                                <source type="image/webp" data-srcset="<%= currentArticle.data.hero.lrg_webp %>">
                                <source type="image/jpeg" data-srcset="<%= currentArticle.data.hero.lrg_jpeg %>">
                                <img class="card__img lazyload"
                                     data-src="<%= currentArticle.data.hero.main %>"
                                     alt="<%= currentArticle.data.alt %>"
                                     height="160"
                                     width="360"<% if (currentArticle.data.hero.position) { %> style="object-position: <%= currentArticle.data.hero.position %>;"<% } %>/>
                            </picture>
                            <div class="card__content">
                                <time class="card__date"><%= currentArticle.data.date %></time>
                                <h3 class="card__header"><%- currentArticle.data.title %></h3>
                                <p class="card__text"><%- currentArticle.data.excerpt %></p>
                            </div>
                            <time class="card__read-time">
                                <%= currentArticle.data.readTime %> READ
                            </time>
                        </a>
                    </article>
                <% } %>
            </article>

            <!-- Empty state -->
            <p id="posts-empty" style="display:none; text-align:center; color:#a89e90; font-size:1.7rem; padding: 6rem 0;">No posts in this category yet.</p>

            <!-- Pagination -->
            <nav id="posts-pagination" class="posts-pagination" aria-label="Posts pagination" style="display:none;">
                <button class="posts-pagination__btn" id="posts-prev" aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <span class="posts-pagination__info" id="posts-page-info"></span>
                <button class="posts-pagination__btn" id="posts-next" aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </nav>

        </div>
    </section>

</main>

<%- include("../partials/footer") %>
<script src="/assets/js/lazysizes.min.js" async></script>
<script>
(function () {
    var POSTS_PER_PAGE = 6;
    var currentCategory = 'all';
    var currentPage = 1;

    var cards = Array.from(document.querySelectorAll('.grid__card-item'));
    var tabs = Array.from(document.querySelectorAll('.my-posts__item'));
    var select = document.getElementById('category-select');
    var pagination = document.getElementById('posts-pagination');
    var prevBtn = document.getElementById('posts-prev');
    var nextBtn = document.getElementById('posts-next');
    var pageInfo = document.getElementById('posts-page-info');
    var emptyState = document.getElementById('posts-empty');

    function getFiltered() {
        if (currentCategory === 'all') return cards;
        return cards.filter(function (c) { return c.dataset.category === currentCategory; });
    }

    function render() {
        var filtered = getFiltered();
        var totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
        if (currentPage > totalPages) currentPage = 1;

        var start = (currentPage - 1) * POSTS_PER_PAGE;
        var visible = filtered.slice(start, start + POSTS_PER_PAGE);

        cards.forEach(function (c) { c.style.display = 'none'; });
        visible.forEach(function (c) { c.style.display = ''; });

        emptyState.style.display = filtered.length === 0 ? 'block' : 'none';

        if (totalPages <= 1) {
            pagination.style.display = 'none';
        } else {
            pagination.style.display = 'flex';
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages;
            pageInfo.textContent = currentPage + ' of ' + totalPages;
        }
    }

    function setCategory(cat) {
        currentCategory = cat;
        currentPage = 1;
        tabs.forEach(function (t) {
            t.classList.toggle('my-posts__item--active', t.dataset.filter === cat);
        });
        if (select) select.value = cat;
        render();
    }

    function scrollToGrid() {
        var section = document.querySelector('.card-wrapper');
        if (section) window.scrollTo({ top: section.offsetTop - 80, behavior: 'smooth' });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { setCategory(tab.dataset.filter); });
        tab.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') setCategory(tab.dataset.filter); });
    });

    if (select) {
        select.addEventListener('change', function () { setCategory(select.value); });
    }

    prevBtn.addEventListener('click', function () {
        if (currentPage > 1) { currentPage--; render(); scrollToGrid(); }
    });

    nextBtn.addEventListener('click', function () {
        var totalPages = Math.ceil(getFiltered().length / POSTS_PER_PAGE);
        if (currentPage < totalPages) { currentPage++; render(); scrollToGrid(); }
    });

    render();
}());
</script>
</body>
</html>
