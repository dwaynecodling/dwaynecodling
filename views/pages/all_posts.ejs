<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Thoughts, insights and reflections from Dwayne Codling — Development Director and people-first leader.">
    <meta name="keywords" content="blog, articles, technology, leadership, insights">
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content="My Posts — Dwayne Codling" />
    <meta property="og:description" content="Thoughts, insights and reflections from Dwayne Codling — Development Director and people-first leader." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/pages/about-me/dwayne-profile.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://dwaynecodling.com/posts" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://dwaynecodling.com/posts" />
    <title>My Posts — Dwayne Codling</title>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "My Posts",
      "description": "Thoughts, insights and reflections from Dwayne Codling — Development Director and people-first leader.",
      "url": "https://dwaynecodling.com/posts"
    }
    </script>
    <%- include("../partials/links") %>
    <style>
        .posts-hero {
            background-image: linear-gradient(to right, rgba(13,26,16,0.97) 0%, rgba(13,26,16,0.6) 100%), url('/assets/img/pages/all-posts/hero-posts@720w.jpg');
            background-size: cover;
            background-position: center 37%;
            border-bottom: 1px solid rgba(200,133,58,0.15);
            padding: 10rem 0 8rem;
        }

        @media screen and (min-width: 62em) {
            .posts-hero {
                background-image: linear-gradient(to right, rgba(13,26,16,0.97) 0%, rgba(13,26,16,0.6) 100%), url('/assets/img/pages/all-posts/hero-posts.jpg');
            }
        }
    </style>
</head>
<body>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <!-- Page Header -->
    <section class="m-bottom-0">
        <div class="posts-hero">
            <div class="container">
                <p class="page-header__label">Writing</p>
                <h1 class="page-header__title">
                    Thoughts &amp; <strong>reflections</strong>
                </h1>
                <p class="page-header__description">
                    Leadership, diversity, tech, and the occasional life lesson from the platform.
                </p>
            </div>
        </div>
    </section>

    <!-- Filter + Posts -->
    <section class="card-wrapper p-top-5">
        <div class="container">

            <!-- Mobile filter -->
            <div class="my-posts__filter my-posts__filter--mobile">
                <label class="my-posts__filter--label" for="category-select">Filter by</label>
                <select class="my-posts__select" id="category-select">
                    <option value="all">All posts</option>
                    <option value="leadership">Leadership</option>
                    <option value="fitness">Fitness</option>
                    <option value="personal">Personal</option>
                    <option value="tech">Tech</option>
                </select>
            </div>

            <!-- Desktop filter tabs -->
            <ul class="my-posts__filter--desktop" role="tablist" aria-label="Filter posts by category">
                <li class="my-posts__item my-posts__item--active" data-filter="all" role="tab" tabindex="0" aria-selected="true">All</li>
                <li class="my-posts__item" data-filter="leadership" role="tab" tabindex="-1" aria-selected="false">Leadership</li>
                <li class="my-posts__item" data-filter="fitness" role="tab" tabindex="-1" aria-selected="false">Fitness</li>
                <li class="my-posts__item" data-filter="personal" role="tab" tabindex="-1" aria-selected="false">Personal</li>
                <li class="my-posts__item" data-filter="tech" role="tab" tabindex="-1" aria-selected="false">Tech</li>
            </ul>

            <!-- Cards grid -->
            <article class="grid grid--card-list">
                <% for (let currentArticle of posts){ %>
                    <article class="grid__card-item" data-category="<%= currentArticle.data.category || 'all' %>">
                        <a href="/post/<%= currentArticle.data.slug %>" class="card">
                            <picture class="card__img-container">
                                <source type="image/avif" srcset="<%= (currentArticle.data.hero.card_webp || currentArticle.data.hero.lrg_webp).replace(/\.webp$/, '.avif') %>">
                                <source type="image/webp" srcset="<%= currentArticle.data.hero.card_webp || currentArticle.data.hero.lrg_webp %>">
                                <source type="image/jpeg" srcset="<%= currentArticle.data.hero.lrg_jpeg %>">
                                <img class="card__img"
                                     src="<%= currentArticle.data.hero.main %>"
                                     alt="<%= currentArticle.data.alt %>"
                                     height="160"
                                     width="360"
                                     loading="lazy"<% if (currentArticle.data.hero.position) { %> style="object-position: <%= currentArticle.data.hero.position %>;"<% } %>/>
                            </picture>
                            <div class="card__content">
                                <time class="card__date"><%= currentArticle.data.date %></time>
                                <h2 class="card__header"><%- currentArticle.data.title %></h2>
                                <p class="card__text"><%- currentArticle.data.excerpt %></p>
                            </div>
                            <time class="card__read-time">
                                <%= currentArticle.data.readTime %> read
                            </time>
                        </a>
                    </article>
                <% } %>
            </article>

            <!-- Empty state -->
            <p id="posts-empty" class="d-none" style="text-align:center; color:#a89e90; font-size:1.7rem; padding: 6rem 0;">No posts in this category yet.</p>

            <!-- Pagination -->
            <nav id="posts-pagination" class="posts-pagination d-none" aria-label="Posts pagination">
                <button class="posts-pagination__btn" id="posts-prev" aria-label="Previous page">
                    <svg class="rotate-90" width="12" height="20" viewBox="0 0 12 20" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                        <rect fill="#fff" x="5" y="0" width="2" height="14" rx="1"/>
                        <path stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M0 10l6 6 6-6"/>
                    </svg>
                </button>
                <span class="posts-pagination__info" id="posts-page-info"></span>
                <button class="posts-pagination__btn" id="posts-next" aria-label="Next page">
                    <svg class="rotate-neg-90" width="12" height="20" viewBox="0 0 12 20" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                        <rect fill="#fff" x="5" y="0" width="2" height="14" rx="1"/>
                        <path stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M0 10l6 6 6-6"/>
                    </svg>
                </button>
            </nav>

        </div>
    </section>

</main>

<%- include("../partials/footer") %>
<script>
(function () {
    var POSTS_PER_PAGE = 6;
    var currentCategory = 'all';
    var currentPage = 1;

    var cards = Array.from(document.querySelectorAll('.grid__card-item'));
    var tabs = Array.from(document.querySelectorAll('.my-posts__item'));
    var select = document.getElementById('category-select');
    var pagination = document.getElementById('posts-pagination');
    var prevBtn = document.getElementById('posts-prev');
    var nextBtn = document.getElementById('posts-next');
    var pageInfo = document.getElementById('posts-page-info');
    var emptyState = document.getElementById('posts-empty');

    function getFiltered() {
        if (currentCategory === 'all') return cards;
        return cards.filter(function (c) { return c.dataset.category === currentCategory; });
    }

    function render() {
        var filtered = getFiltered();
        var totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
        if (currentPage > totalPages) currentPage = 1;

        var start = (currentPage - 1) * POSTS_PER_PAGE;
        var visible = filtered.slice(start, start + POSTS_PER_PAGE);

        cards.forEach(function (c) { c.classList.add('hidden'); });
        visible.forEach(function (c) { c.classList.remove('hidden'); });

        emptyState.style.display = filtered.length === 0 ? 'block' : 'none';

        if (totalPages <= 1) {
            pagination.style.display = 'none';
        } else {
            pagination.style.display = 'flex';
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages;
            pageInfo.textContent = currentPage + ' of ' + totalPages;
        }
    }

    var validCategories = ['all', 'leadership', 'fitness', 'personal', 'tech'];

    function updateURL() {
        var params = new URLSearchParams();
        if (currentCategory !== 'all') params.set('category', currentCategory);
        if (currentPage > 1) params.set('page', currentPage);
        var newURL = params.toString() ? location.pathname + '?' + params.toString() : location.pathname;
        history.replaceState(null, '', newURL);
    }

    function setCategory(cat, updateURL_flag) {
        currentCategory = cat;
        currentPage = 1;
        tabs.forEach(function (t) {
            var isActive = t.dataset.filter === cat;
            t.classList.toggle('my-posts__item--active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
            t.setAttribute('tabindex', isActive ? '0' : '-1');
        });
        if (select) select.value = cat;
        if (updateURL_flag !== false) {
            updateURL();
        }
        render();
    }

    function scrollToGrid() {
        var section = document.querySelector('.card-wrapper');
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { setCategory(tab.dataset.filter); });
        tab.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') setCategory(tab.dataset.filter); });
    });

    if (select) {
        select.addEventListener('change', function () { setCategory(select.value); });
    }

    prevBtn.addEventListener('click', function () {
        if (currentPage > 1) { currentPage--; updateURL(); render(); scrollToGrid(); }
    });

    nextBtn.addEventListener('click', function () {
        var totalPages = Math.ceil(getFiltered().length / POSTS_PER_PAGE);
        if (currentPage < totalPages) { currentPage++; updateURL(); render(); scrollToGrid(); }
    });

    var params = new URLSearchParams(location.search);
    var initialCat = params.get('category') || location.hash.slice(1) || 'all';
    var initialPage = parseInt(params.get('page'), 10) || 1;

    setCategory(validCategories.indexOf(initialCat) !== -1 ? initialCat : 'all', false);
    currentPage = initialPage;
    render();
}());
</script>
</body>
</html>
