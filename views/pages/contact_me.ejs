<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Get in touch with Dwayne Codling — Development Director, people-first leader, and D&I advocate based in Nottingham.">
    <meta name="keywords" content="contact, get in touch, Nottingham, development director">
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content="Contact Me — Dwayne Codling" />
    <meta property="og:description" content="Get in touch with Dwayne Codling — Development Director, people-first leader, and D&I advocate." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/pages/about-me/dwayne-profile.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://dwaynecodling.com/contact-me" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://dwaynecodling.com/contact-me" />
    <title>Contact Me — Dwayne Codling</title>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPoint",
      "contactType": "Customer Service",
      "email": "dwayneandrecodling@gmail.com",
      "url": "https://dwaynecodling.com/contact-me",
      "areaServed": "GB"
    }
    </script>
    <%- include("../partials/links") %>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"
            integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo="
            crossorigin="anonymous"></script>
    <script src="https://www.google.com/recaptcha/enterprise.js?render=6LfODfcsAAAAAMbRVjQS77rzMFDdyMFZmddQ7D3c"></script>
</head>

<body>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <section>
        <div class="container">
            <div class="contact-form">
                <picture class="contact-form__img-wrapper">
                    <source type="image/webp" srcset="/assets/img/pages/contact/contact.webp">
                    <source type="image/jpeg" srcset="/assets/img/pages/contact/contact.jpg">
                    <img class="contact-form__img" src="/assets/img/pages/contact/contact.jpg" alt="Dwayne Codling, Development Director based in Nottingham" loading="lazy">
                </picture>
                <div class="contact-form__content-wrapper">
                    <div class="contact-form__content">
                        <span class="info-snippet__bg-text" aria-hidden="true">05</span>
                        <h1 class="contact-form__title">Let's have a <strong>conversation</strong>.</h1>
                        <p class="contact-form__text">Fill in the form and I'll get back to you as soon as I can. Prefer a quicker route? Reach me on <a href="https://wa.me/447913118176" target="_blank" rel="noopener noreferrer">WhatsApp</a> or via Google Meet.</p>
                    </div>

                    <form id="contactForm" action="/form/contact" method="post" class="contact-form__form">
                        <div id="form-status" aria-live="polite" aria-atomic="true" role="status" class="contact-form__status"></div>
                        <fieldset>
                            <div id="field-name-field" class="contact-form__name-field">
                                <label for="name-field" class="contact-form__label">What is your name?</label>
                            </div>
                            <div class="contact-form__control">
                                <input name="name" type="text" class="contact-form__input" id="name-field" placeholder="Your name" aria-required="true" aria-invalid="false" aria-describedby="error-name">
                                <div id="error-name" role="alert" class="contact-form__error"></div>
                            </div>
                            <div id="field-email-field" class="contact-form__name-field">
                                <label for="email-field" class="contact-form__label">What is your email?</label>
                            </div>
                            <div class="contact-form__control">
                                <input name="email" type="email" class="contact-form__input" id="email-field" placeholder="Your email" aria-required="true" aria-invalid="false" aria-describedby="error-email">
                                <div id="error-email" role="alert" class="contact-form__error"></div>
                            </div>
                            <div id="field-textarea" class="contact-form__textarea">
                                <label for="textarea" class="contact-form__label">How can I help?</label>
                            </div>
                            <div class="contact-form__control">
                    <textarea
                            name="message"
                            class="contact-form__textarea-input"
                            id="textarea"
                            placeholder="Your message"
                            aria-required="true"
                            aria-invalid="false"
                            aria-describedby="error-message"
                    ></textarea>
                                <div id="error-message" role="alert" class="contact-form__error"></div>
                            </div>
                            <button class="contact-form__button" type="submit">
                                Send message
                            </button>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>

</main>

<%- include("../partials/footer") %>

<script>
    function sendFormData(action, method, formData, callback){
        $.ajax({
            url:action,
            type: method,
            data: formData,
            success: callback,
            dataType: "json",
            contentType: false,
            processData:false
        });
    }

    function validateForm(form) {
        let isValid = true;
        const nameField = document.getElementById('name-field');
        const emailField = document.getElementById('email-field');
        const messageField = document.getElementById('textarea');

        // Clear previous error messages
        document.getElementById('error-name').textContent = '';
        document.getElementById('error-email').textContent = '';
        document.getElementById('error-message').textContent = '';

        // Reset aria-invalid
        nameField.setAttribute('aria-invalid', 'false');
        emailField.setAttribute('aria-invalid', 'false');
        messageField.setAttribute('aria-invalid', 'false');

        // Validate name
        if (nameField.value.trim() === '') {
            document.getElementById('error-name').textContent = 'Name is required';
            nameField.setAttribute('aria-invalid', 'true');
            isValid = false;
        }

        // Validate email
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailField.value.trim() === '') {
            document.getElementById('error-email').textContent = 'Email is required';
            emailField.setAttribute('aria-invalid', 'true');
            isValid = false;
        } else if (!emailRegex.test(emailField.value)) {
            document.getElementById('error-email').textContent = 'Please enter a valid email address';
            emailField.setAttribute('aria-invalid', 'true');
            isValid = false;
        }

        // Validate message
        if (messageField.value.trim() === '') {
            document.getElementById('error-message').textContent = 'Message is required';
            messageField.setAttribute('aria-invalid', 'true');
            isValid = false;
        }

        return isValid;
    }

    $('#contactForm').submit(function(ev) {
        ev.preventDefault();
        let form = this;
        let $btn = $(form).find('button');
        let formStatus = document.getElementById('form-status');

        // Clear previous status message
        formStatus.textContent = '';

        // Validate form
        if (!validateForm(form)) {
            formStatus.textContent = 'Please fix the errors below';
            formStatus.style.color = '#ff6b6b';
            return;
        }

        let fData = new FormData(form);
        $btn.prop('disabled', true).text('Sending...');

        grecaptcha.enterprise.ready(function() {
            grecaptcha.enterprise.execute('6LfODfcsAAAAAMbRVjQS77rzMFDdyMFZmddQ7D3c', {action: 'send_message'}).then(function(token) {
                fData.append("token", token);
                fData.append("action", "send_message");
                sendFormData(form.getAttribute("action"), form.getAttribute("method"), fData, data => {

                    if (data.isSuccessful === true){
                        form.reset();
                        $btn.prop('disabled', false).text('Message sent!');
                        formStatus.textContent = 'Your message has been sent successfully!';
                        formStatus.style.color = '#c8853a';
                        document.getElementById('name-field').setAttribute('aria-invalid', 'false');
                        document.getElementById('email-field').setAttribute('aria-invalid', 'false');
                        document.getElementById('textarea').setAttribute('aria-invalid', 'false');
                        setTimeout(() => {
                            $btn.text('Send message');
                        }, 2000);
                    } else {
                        $btn.prop('disabled', false).text('Send message');
                        formStatus.textContent = 'Unable to send message. Please try again.';
                        formStatus.style.color = '#e74c3c';
                    }

                });
            });
        });
    });
</script>
</body>

</html>