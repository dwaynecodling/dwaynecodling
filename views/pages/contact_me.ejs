<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Get in touch with Dwayne Codling — Development Director, people-first leader, and D&I advocate based in Nottingham.">
    <meta property="og:title" content="Contact Me — Dwayne Codling" />
    <meta property="og:description" content="Get in touch with Dwayne Codling — Development Director, people-first leader, and D&I advocate." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/pages/about-me/dwayne-profile.jpg" />
    <title>Contact Me — Dwayne Codling</title>
    <%- include("../partials/links") %>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"
            integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo="
            crossorigin="anonymous"></script>
    <script src="https://www.google.com/recaptcha/api.js?render=6Lcdhd4sAAAAAOxvi9Pgtnb4sejx0SNPT_-XTOsx"></script>
</head>

<body>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <section>
        <div class="container">
            <div class="contact-form">
                <picture class="contact-form__img-wrapper">
                    <source type="image/jpeg" data-srcset="/assets/img/pages/contact/contact.jpg">
                    <img class="contact-form__img lazyload" data-src="/assets/img/pages/contact/contact.jpg" alt="Dwayne Codling">
                </picture>
                <div class="contact-form__content-wrapper">
                    <div class="contact-form__content">
                        <span class="info-snippet__bg-text">05</span>
                        <h2 class="contact-form__title">Let's have a conversation.</h2>
                        <p class="contact-form__text">Fill in the form and I'll get back to you as soon as I can. Prefer a quicker route? Reach me on <a href="https://wa.me/447913118176" target="_blank" rel="noopener noreferrer">WhatsApp</a> or via Google Meet.</p>
                    </div>

                    <form id="contactForm" action="/form/contact" method="post" class="contact-form__form">
                        <fieldset>
                            <div id="field-name-field" class="contact-form__name-field">
                                <label for="name-field" class="contact-form__label">What is your name?</label>
                            </div>
                            <div class="contact-form__control">
                                <input name="name" type="text" class="contact-form__input" id="name-field" placeholder="Your name">
                            </div>
                            <div id="field-email-field" class="contact-form__name-field">
                                <label for="email-field" class="contact-form__label">What is your email?</label>
                            </div>
                            <div class="contact-form__control">
                                <input name="email" type="email" class="contact-form__input" id="email-field" placeholder="Your email">
                            </div>
                            <div id="field-textarea" class="contact-form__textarea">
                                <label for="textarea" class="contact-form__label">How can I help?</label>
                            </div>
                            <div class="contact-form__control">
                    <textarea
                            name="message"
                            class="contact-form__textarea-input"
                            id="textarea"
                            placeholder="Your message"
                    ></textarea>
                            </div>
                            <button class="contact-form__button">
                    <span class="hero__button-content">
                        <span class="hero__button-text">Send message</span>
                        <svg class="hero__button-arrow" width="20" height="12" viewBox="0 0 20 12" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                            <rect fill="#FFF" x="0" y="5" width="14" height="2" rx="1"/>
                            <path stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 0l6 6-6 6"/>
                        </svg>
                    </span>
                            </button>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>

</main>

<%- include("../partials/footer") %>

<script>
    function sendFormData(action, method, formData, callback){
        $.ajax({
            url:action,
            type: method,
            data: formData,
            success: callback,
            dataType: "json",
            contentType: false,
            processData:false
        });
    }

    $('#contactForm').submit(function(ev) {
        ev.preventDefault();
        let form = this;
        let $btn = $(form).find('button');
        let fData = new FormData(form);

        $btn.prop('disabled', true).find('.hero__button-text').text('Sending...');

        grecaptcha.ready(function() {
            grecaptcha.execute('6Lcdhd4sAAAAAOxvi9Pgtnb4sejx0SNPT_-XTOsx', {action: 'send_message'}).then(function(token) {
                fData.append("token", token);
                fData.append("action", "send_message");
                sendFormData(form.getAttribute("action"), form.getAttribute("method"), fData, data => {

                    if (data.isSuccessful === true){
                        form.reset();
                        $btn.find('.hero__button-text').text('Message sent!');
                    } else {
                        $btn.prop('disabled', false).find('.hero__button-text').text('Send message');
                        alert('Unable to send message. Please try again.');
                    }

                });
            });
        });
    });
</script>
<script src="/assets/js/lazysizes.min.js" async></script>
</body>

</html>