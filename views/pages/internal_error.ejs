<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Something went wrong — Dwayne Codling">
    <title>500 — Dwayne Codling</title>
    <%- include("../partials/links") %>
    <style>
        .error-page {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 70vh;
            padding: 8rem 2rem;
        }

        .error-page__code {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 12rem;
            font-weight: 900;
            line-height: 1;
            color: #c8853a;
            opacity: 0.3;
            margin-bottom: 2rem;
        }

        .error-page__heading {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-2);
            font-weight: 700;
            color: #f4ede0;
            margin-bottom: 1.6rem;
        }

        .error-page__text {
            font-size: 1.7rem;
            line-height: 3rem;
            color: #a89e90;
            max-width: 44rem;
            margin-bottom: 4rem;
        }

        .error-page__links {
            display: flex;
            flex-wrap: wrap;
            gap: 1.6rem;
            justify-content: center;
        }
    </style>
</head>
<body>
<%- include("../partials/nav") %>

<main class="content" role="main">
    <div class="container">
        <div class="error-page">
            <p class="error-page__code">500</p>
            <h1 class="error-page__heading">Something went wrong</h1>
            <p class="error-page__text">There was a problem on our end. It's not you. Head back home and try again.</p>
            <div class="error-page__links">
                <a href="/" class="hero__button">Back to home</a>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/footer") %>
</body>
</html>
