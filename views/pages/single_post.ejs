<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="<%= currentArticle.data.excerpt %>">
    <meta name="keywords" content="<%= currentArticle.data.category %>, <%= currentArticle.data.category ? currentArticle.data.category + ', ' : '' %>technology, leadership, insights">
    <title><%- currentArticle.data.titleText %> — Dwayne Codling</title>
    <meta property="og:title" content="<%= currentArticle.data.titleText %>" />
    <meta property="og:description" content="<%= currentArticle.data.excerpt %>" />
    <meta property="og:image" content="https://dwaynecodling.com<%= currentArticle.data.hero.lrg_jpeg %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://dwaynecodling.com/post/<%= currentArticle.data.slug %>" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content="<%= (function(){ var d=new Date(currentArticle.data.date); return isNaN(d)?'':d.toISOString(); })() %>" />
    <meta property="article:author" content="https://dwaynecodling.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@codling" />
    <meta name="twitter:title" content="<%- currentArticle.data.titleText %>" />
    <meta name="twitter:description" content="<%= currentArticle.data.excerpt %>" />
    <meta name="twitter:image" content="https://dwaynecodling.com<%= currentArticle.data.hero.lrg_jpeg %>" />
    <link rel="canonical" href="https://dwaynecodling.com/post/<%= currentArticle.data.slug %>" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": <%- JSON.stringify(currentArticle.data.titleText) %>,
      "description": <%- JSON.stringify(currentArticle.data.excerpt) %>,
      "image": "https://dwaynecodling.com<%= currentArticle.data.hero.lrg_jpeg %>",
      "url": "https://dwaynecodling.com/post/<%= currentArticle.data.slug %>",
      "datePublished": "<%= (function(){ var d=new Date(currentArticle.data.date); return isNaN(d)?'':d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); })() %>",
      "author": {
        "@type": "Person",
        "name": "Dwayne Codling",
        "url": "https://dwaynecodling.com",
        "sameAs": [
          "https://x.com/codling",
          "https://www.linkedin.com/in/dwayne-codling/",
          "https://github.com/dwaynecodling"
        ]
      },
      "publisher": {
        "@type": "Person",
        "name": "Dwayne Codling",
        "url": "https://dwaynecodling.com"
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://dwaynecodling.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Posts",
          "item": "https://dwaynecodling.com/posts"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": <%- JSON.stringify(currentArticle.data.titleText) %>,
          "item": "https://dwaynecodling.com/post/<%= currentArticle.data.slug %>"
        }
      ]
    }
    </script>
    <%- include("../partials/links") %>
    <style>
.post-hero {
            background-color: #162419;
            border-bottom: 1px solid rgba(200,133,58,0.15);
            padding: 8rem 0 6rem;
        }

        .post-hero__meta {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-bottom: 2.4rem;
            flex-wrap: wrap;
        }

        .post-hero__tag {
            font-size: 1.2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #c8853a;
            background: rgba(200,133,58,0.12);
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.4rem 1.2rem;
            border-radius: 99px;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s;
        }
        .post-hero__tag:after { display: none; }
        .post-hero__tag:hover {
            background: rgba(200,133,58,0.22);
            border-color: rgba(200,133,58,0.55);
        }

        .post-hero__date {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__read-time {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-1);
            font-weight: 700;
            color: #f4ede0;
            line-height: 1.2;
            max-width: 76rem;
            margin-bottom: 0;
        }

        .post-share {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(200,133,58,0.15);
        }

        .post-share__label {
            font-size: 1.3rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #a89e90;
        }

        .post-share__link {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.4rem;
            font-weight: 600;
            color: #c8853a;
            text-decoration: none;
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.6rem 1.4rem;
            border-radius: 99px;
            transition: all .2s;
        }

        .post-share__link:hover {
            background-color: rgba(200,133,58,0.1);
        }

        .post-share__link:focus-visible {
            outline: 2px solid #c8853a;
            outline-offset: 2px;
        }

        .post-share__link:after { display: none; }

        button.post-share__link {
            background-color: #c8853a;
            color: #0d1a10;
            font-family: inherit;
            font-size: 1.5rem;
            cursor: pointer;
            border: none;
            padding: 1.4rem 3rem;
            letter-spacing: 0.02em;
        }

        button.post-share__link:hover {
            background-color: #b8742a;
            color: #f4ede0;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(200,133,58,0.35);
        }

        button.post-share__link:focus-visible {
            outline: 2px solid #f4ede0;
            outline-offset: 2px;
        }

        .post-back {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.3rem;
            font-weight: 600;
            color: #a89e90;
            text-decoration: none;
            margin-bottom: 2.4rem;
            transition: color .2s;
        }

        .post-back:hover { color: #c8853a; }
        .post-back:focus-visible { outline: 2px solid #c8853a; outline-offset: 2px; }
        .post-back:after { display: none; }

        .back-to-top {
            position: fixed;
            bottom: 3.2rem;
            right: 3.2rem;
            width: 6rem;
            height: 6rem;
            border-radius: 50%;
            background-color: rgba(13,26,16,0.85);
            color: #f4ede0;
            border: .2rem solid rgba(244,237,224,0.4);
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: translateY(12px);
            transition: opacity .25s, transform .25s, border-color .2s;
            z-index: 100;
            -webkit-appearance: none;
            appearance: none;
            -webkit-tap-highlight-color: transparent;
        }

        .back-to-top.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .back-to-top:hover {
            border-color: #c8853a;
        }

        .back-to-top:focus-visible {
            outline: 2px solid #f4ede0;
            outline-offset: 2px;
        }

        .back-to-top:active {
            background-color: rgba(13,26,16,0.85);
            border-color: rgba(244,237,224,0.4);
        }

    </style>
</head>

<body>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <!-- Post Header -->
    <section style="margin-bottom:0;">
        <div class="post-hero">
            <div class="container">
                <a href="/posts" class="post-back">
                    <svg width="20" height="12" viewBox="0 0 20 12" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                        <rect fill="currentColor" x="6" y="5" width="14" height="2" rx="1"/>
                        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 0l-6 6 6 6"/>
                    </svg>
                    Back to all posts
                </a>
                <div class="post-hero__meta">
                    <a href="/posts#<%= currentArticle.data.category || 'all' %>" class="post-hero__tag"><%= currentArticle.data.category ? currentArticle.data.category.charAt(0).toUpperCase() + currentArticle.data.category.slice(1) : 'Writing' %></a>
                    <span class="post-hero__date"><%- currentArticle.data.date %></span>
                    <span class="post-hero__read-time">· <%- currentArticle.data.readTime %> read</span>
                </div>
                <h1 class="post-hero__title"><%- currentArticle.data.title %></h1>
            </div>
        </div>
    </section>

    <!-- Hero image or video -->
    <section style="margin-bottom:0; padding-top: 4rem;">
        <div class="container">
            <% if (currentArticle.data.hero.video_yt){ %>
                <div class="post-template__iframe-wrapper">
                    <iframe
                        class="post-template__iframe"
                        width="100%" height="100%"
                        src="https://www.youtube-nocookie.com/embed/<%= currentArticle.data.hero.video_yt %>"
                        frameborder="0"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            <% } else { %>
                <div class="post-template__img-wrapper">
                    <picture>
                        <source type="image/webp" srcset="<%= currentArticle.data.hero.lrg_webp %>">
                        <source type="image/jpeg" srcset="<%= currentArticle.data.hero.lrg_jpeg %>">
                        <img class="post-template__img" src="<%= currentArticle.data.hero.main %>" alt="<%= currentArticle.data.alt %>" loading="lazy"<% if (currentArticle.data.hero.position) { %> style="object-position: <%= currentArticle.data.hero.position %>;"<% } %>>
                    </picture>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Post content -->
    <section>
        <div class="container">
            <div class="post-template__content">
                <%- currentArticle.content %>
            </div>

            <!-- Share -->
            <div class="post-share" style="max-width:72rem; margin:5rem auto 0;">
                <button class="post-share__link" onclick="sharePost(this)">Share this post</button>
            </div>
            <script>
                function sharePost(btn) {
                    var title = '<%- currentArticle.data.titleText %>';
                    var url = window.location.href;
                    if (navigator.share) {
                        navigator.share({ title: title, url: url });
                    } else {
                        navigator.clipboard.writeText(url).then(function() {
                            btn.textContent = 'Link copied!';
                            setTimeout(function() { btn.textContent = 'Share this post'; }, 2000);
                        });
                    }
                }
            </script>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>

</main>

<button class="back-to-top" id="back-to-top" aria-label="Back to top">
    <svg style="transform:rotate(180deg);" width="12" height="20" viewBox="0 0 12 20" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
        <rect fill="#fff" x="5" y="0" width="2" height="14" rx="1"/>
        <path stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M0 10l6 6 6-6"/>
    </svg>
</button>

<%- include("../partials/footer") %>
<script>
(function () {
    var btn = document.getElementById('back-to-top');
    var hero = document.querySelector('.post-hero');

    // Back-to-top: IntersectionObserver — the browser tracks visibility natively,
    // no JS scroll reading needed, works on all iOS Safari versions.
    if ('IntersectionObserver' in window && hero) {
        new IntersectionObserver(function (entries) {
            btn.classList.toggle('visible', !entries[0].isIntersecting);
        }, { threshold: 0 }).observe(hero);
    } else {
        window.addEventListener('scroll', function () {
            btn.classList.toggle('visible', (window.pageYOffset || document.documentElement.scrollTop || 0) > 400);
        }, { passive: true });
    }

    btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        this.blur();
    });
}());
</script>
</body>
</html>
