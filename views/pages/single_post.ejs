<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="<%= currentArticle.data.excerpt %>">
    <title><%- currentArticle.data.titleText %> — Dwayne Codling</title>
    <meta property="og:title" content="<%= currentArticle.data.titleText %>" />
    <meta property="og:description" content="<%= currentArticle.data.excerpt %>" />
    <meta property="og:image" content="https://dwaynecodling.com<%= currentArticle.data.hero.lrg_jpeg %>" />
    <%- include("../partials/links") %>
    <style>
        .reading-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 3px;
            background-color: #c8853a;
            z-index: 9999;
            transition: width 0.1s linear;
        }

        .post-hero {
            background-color: #162419;
            border-bottom: 1px solid rgba(200,133,58,0.15);
            padding: 8rem 0 6rem;
        }

        .post-hero__meta {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-bottom: 2.4rem;
            flex-wrap: wrap;
        }

        .post-hero__tag {
            font-size: 1.2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #c8853a;
            background: rgba(200,133,58,0.12);
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.4rem 1.2rem;
            border-radius: 99px;
        }

        .post-hero__date {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__read-time {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-1);
            font-weight: 700;
            color: #f4ede0;
            line-height: 1.2;
            max-width: 76rem;
            margin-bottom: 0;
        }

        .post-share {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(200,133,58,0.15);
        }

        .post-share__label {
            font-size: 1.3rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #a89e90;
        }

        .post-share__link {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.4rem;
            font-weight: 600;
            color: #c8853a;
            text-decoration: none;
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.6rem 1.4rem;
            border-radius: 99px;
            transition: all .2s;
        }

        .post-share__link:hover {
            background-color: rgba(200,133,58,0.1);
        }

        .post-share__link:after { display: none; }

        button.post-share__link {
            background-color: #c8853a;
            color: #0d1a10;
            font-family: inherit;
            font-size: 1.5rem;
            cursor: pointer;
            border: none;
            padding: 1.4rem 3rem;
            letter-spacing: 0.02em;
        }

        button.post-share__link:hover {
            background-color: #b8742a;
            color: #f4ede0;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(200,133,58,0.35);
        }

        .post-back {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.3rem;
            font-weight: 600;
            color: #a89e90;
            text-decoration: none;
            margin-bottom: 2.4rem;
            transition: color .2s;
        }

        .post-back:hover { color: #c8853a; }
        .post-back:after { display: none; }
    </style>
</head>

<body>
<div class="reading-progress" id="reading-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Reading progress"></div>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <!-- Post Header -->
    <section style="margin-bottom:0;">
        <div class="post-hero">
            <div class="container">
                <a href="/posts" class="post-back">
                    <svg width="20" height="12" viewBox="0 0 20 12" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
                        <rect fill="currentColor" x="6" y="5" width="14" height="2" rx="1"/>
                        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 0l-6 6 6 6"/>
                    </svg>
                    Back to all posts
                </a>
                <div class="post-hero__meta">
                    <span class="post-hero__tag"><%= currentArticle.data.category ? currentArticle.data.category.charAt(0).toUpperCase() + currentArticle.data.category.slice(1) : 'Writing' %></span>
                    <span class="post-hero__date"><%- currentArticle.data.date %></span>
                    <span class="post-hero__read-time">· <%- currentArticle.data.readTime %> read</span>
                </div>
                <h1 class="post-hero__title"><%- currentArticle.data.title %></h1>
            </div>
        </div>
    </section>

    <!-- Hero image or video -->
    <section style="margin-bottom:0; padding-top: 4rem;">
        <div class="container">
            <% if (currentArticle.data.hero.video_yt){ %>
                <div class="post-template__iframe-wrapper">
                    <iframe
                        class="post-template__iframe"
                        width="100%" height="100%"
                        src="https://www.youtube-nocookie.com/embed/<%= currentArticle.data.hero.video_yt %>"
                        frameborder="0"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            <% } else { %>
                <div class="post-template__img-wrapper">
                    <picture>
                        <source type="image/webp" data-srcset="<%= currentArticle.data.hero.lrg_webp %>">
                        <source type="image/jpeg" data-srcset="<%= currentArticle.data.hero.lrg_jpeg %>">
                        <img class="post-template__img lazyload" data-src="<%= currentArticle.data.hero.main %>" alt="<%= currentArticle.data.alt %>"<% if (currentArticle.data.hero.position) { %> style="object-position: <%= currentArticle.data.hero.position %>;"<% } %>>
                    </picture>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Post content -->
    <section>
        <div class="container">
            <div class="post-template__content">
                <%- currentArticle.content %>
            </div>

            <!-- Share -->
            <div class="post-share" style="max-width:72rem; margin:5rem auto 0;">
                <button class="post-share__link" onclick="sharePost(this)">Share this post</button>
            </div>
            <script>
                function sharePost(btn) {
                    var title = '<%- currentArticle.data.titleText %>';
                    var url = window.location.href;
                    if (navigator.share) {
                        navigator.share({ title: title, url: url });
                    } else {
                        navigator.clipboard.writeText(url).then(function() {
                            btn.textContent = 'Link copied!';
                            setTimeout(function() { btn.textContent = 'Share this post'; }, 2000);
                        });
                    }
                }
            </script>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>

</main>

<%- include("../partials/footer") %>
<script src="/assets/js/lazysizes.min.js" async></script>
<script>
(function () {
    var bar = document.getElementById('reading-progress');
    var content = document.querySelector('.post-template__content');
    function update() {
        var contentTop = content.offsetTop;
        var contentHeight = content.offsetHeight;
        var scrolled = window.scrollY - contentTop;
        var total = contentHeight - window.innerHeight;
        var pct = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;
        bar.style.width = pct + '%';
        bar.setAttribute('aria-valuenow', Math.round(pct));
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
}());
</script>
</body>
</html>
