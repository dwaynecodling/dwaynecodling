<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="<%= currentArticle.data.excerpt %>">
    <title><%- currentArticle.data.titleText %> — Dwayne Codling</title>
    <meta property="og:title" content="<%= currentArticle.data.titleText %>" />
    <meta property="og:description" content="<%= currentArticle.data.excerpt %>" />
    <meta property="og:image" content="https://dwaynecodling.com<%= currentArticle.data.hero.lrg_jpeg %>" />
    <%- include("../partials/links") %>
    <style>
        .post-hero {
            background-color: #162419;
            border-bottom: 1px solid rgba(200,133,58,0.15);
            padding: 8rem 0 6rem;
        }

        .post-hero__meta {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-bottom: 2.4rem;
            flex-wrap: wrap;
        }

        .post-hero__tag {
            font-size: 1.2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #c8853a;
            background: rgba(200,133,58,0.12);
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.4rem 1.2rem;
            border-radius: 99px;
        }

        .post-hero__date {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__read-time {
            font-size: 1.3rem;
            color: #a89e90;
            font-weight: 400;
        }

        .post-hero__title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-1);
            font-weight: 700;
            color: #f4ede0;
            line-height: 1.2;
            max-width: 76rem;
            margin-bottom: 0;
        }

        .post-share {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(200,133,58,0.15);
        }

        .post-share__label {
            font-size: 1.3rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #a89e90;
        }

        .post-share__link {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.4rem;
            font-weight: 600;
            color: #c8853a;
            text-decoration: none;
            border: 1px solid rgba(200,133,58,0.3);
            padding: 0.6rem 1.4rem;
            border-radius: 99px;
            transition: all .2s;
        }

        .post-share__link:hover {
            background-color: rgba(200,133,58,0.1);
        }

        .post-share__link:after { display: none; }

        button.post-share__link {
            background: none;
            font-family: inherit;
            cursor: pointer;
            border: 1px solid rgba(200,133,58,0.3);
        }

        .post-back {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 1.4rem;
            font-weight: 600;
            color: #a89e90;
            text-decoration: none;
            margin-bottom: 4rem;
            transition: color .2s;
        }

        .post-back:hover { color: #c8853a; }
        .post-back:after { display: none; }
    </style>
</head>

<body>
<%- include("../partials/nav") %>

<main class="content" role="main">

    <!-- Post Header -->
    <section style="margin-bottom:0;">
        <div class="post-hero">
            <div class="container">
                <div class="post-hero__meta">
                    <span class="post-hero__tag">Writing</span>
                    <span class="post-hero__date"><%- currentArticle.data.date %></span>
                    <span class="post-hero__read-time">· <%- currentArticle.data.readTime %> read</span>
                </div>
                <h1 class="post-hero__title"><%- currentArticle.data.title %></h1>
            </div>
        </div>
    </section>

    <!-- Hero image or video -->
    <section style="margin-bottom:0; padding-top: 4rem;">
        <div class="container">
            <% if (currentArticle.data.hero.video_yt){ %>
                <div class="post-template__iframe-wrapper">
                    <iframe
                        class="post-template__iframe"
                        width="100%" height="100%"
                        src="https://www.youtube-nocookie.com/embed/<%= currentArticle.data.hero.video_yt %>"
                        frameborder="0"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            <% } else { %>
                <div class="post-template__img-wrapper">
                    <picture>
                        <source type="image/webp" data-srcset="<%= currentArticle.data.hero.lrg_webp %>">
                        <source type="image/jpeg" data-srcset="<%= currentArticle.data.hero.lrg_jpeg %>">
                        <img class="post-template__img lazyload" data-src="<%= currentArticle.data.hero.main %>" alt="<%= currentArticle.data.alt %>">
                    </picture>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Post content -->
    <section>
        <div class="container">
            <a href="/posts" class="post-back">
                ← Back to all posts
            </a>
            <div class="post-template__content">
                <%- currentArticle.content %>
            </div>

            <!-- Share -->
            <div class="post-share" style="max-width:72rem; margin:5rem auto 0;">
                <span class="post-share__label">Share</span>
                <button class="post-share__link" onclick="sharePost(this)">Share this post</button>
            </div>
            <script>
                function sharePost(btn) {
                    var title = '<%- currentArticle.data.titleText %>';
                    var url = window.location.href;
                    if (navigator.share) {
                        navigator.share({ title: title, url: url });
                    } else {
                        navigator.clipboard.writeText(url).then(function() {
                            btn.textContent = 'Link copied!';
                            setTimeout(function() { btn.textContent = 'Share this post'; }, 2000);
                        });
                    }
                }
            </script>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>

</main>

<%- include("../partials/footer") %>
<script src="/assets/js/lazysizes.min.js" async></script>
</body>
</html>
