<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="Dwayne Codling — Development Director, people-first leader, and D&I advocate based in Nottingham.">
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@codling" />
    <meta property="og:title" content="Dwayne Codling" />
    <meta property="og:description" content="Development Director. People-first leader. D&I advocate." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/dwayne_sml.jpg" />
    <title>Dwayne Codling</title>
    <%- include("../partials/links") %>
</head>
<body>
<%- include("../partials/nav") %>

<main class="content" role="main">

    <!-- Hero -->
    <section style="margin-bottom:0; padding:0;">
        <div class="hero">
            <div class="hero__content">
                <span class="open-badge">
                    <span class="open-badge__dot"></span>
                    Open to new opportunities
                </span>
                <p class="hero__subheading">Development Director &middot; People-first Leader</p>
                <h1 class="hero__heading">Hi, I'm <strong>Dwayne</strong>.<br>I build teams that last.</h1>
                <p class="hero__intro">Over a decade transforming how agencies grow; through great people, inclusive culture, and technology that delivers.</p>
                <div class="hero__cta-group">
                    <a href="/about-me" class="hero__button">
                        More about me
                    </a>
                    <a href="/contact-me" class="hero__button hero__button--outline">
                        Get in touch
                    </a>
                </div>
            </div>
            <a class="hero__down-arrow" href="#pillars" aria-label="Scroll to learn more">
                <svg width="12" height="20" viewBox="0 0 12 20" xmlns="http://www.w3.org/2000/svg" fill="none">
                    <rect fill="#fff" x="5" y="0" width="2" height="14" rx="1"/>
                    <path stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M0 10l6 6 6-6"/>
                </svg>
            </a>
        </div>
    </section>

    <!-- Three Pillars -->
    <section id="pillars">
        <div class="container">
            <article class="grid grid--list-of-3">
                <article class="grid__info">
                    <div class="info-snippet">
                        <span class="info-snippet__bg-text">01</span>
                        <span class="info-snippet__accent"></span>
                        <h3 class="info-snippet__heading">Technology Leader</h3>
                        <p class="info-snippet__text">From frontend developer to Development Director; over a decade guiding teams to do their best work, shipping great products, and building something that outlasts any single project.</p>
                    </div>
                </article>
                <article class="grid__info">
                    <div class="info-snippet">
                        <span class="info-snippet__bg-text">02</span>
                        <span class="info-snippet__accent"></span>
                        <h3 class="info-snippet__heading">Champion of Inclusion</h3>
                        <p class="info-snippet__text">Diverse teams build better products. I've spoken at Tech Nottingham, DXN, and allyship events across the UK — because representation in tech isn't optional; it's essential.</p>
                    </div>
                </article>
                <article class="grid__info">
                    <div class="info-snippet">
                        <span class="info-snippet__bg-text">03</span>
                        <span class="info-snippet__accent"></span>
                        <h3 class="info-snippet__heading">Powerlifter</h3>
                        <p class="info-snippet__text">Setbacks are part of the process; how you respond defines the outcome. I compete in raw powerlifting and apply that same resilience to everything I do.</p>
                    </div>
                </article>
            </article>
        </div>
    </section>

    <!-- Strength Section -->
    <section style="margin-bottom:0;">
        <div class="strength-section">
            <div class="strength-section__image">
                <img src="/assets/img/pages/dwayne-competition.jpg"
                     alt="Dwayne Codling competing at the WRPF Great Britain powerlifting competition"
                     loading="lazy" />
            </div>
            <div class="strength-section__content">
                <p class="strength-section__label">Beyond the work</p>
                <h2 class="strength-section__heading">Forward ever,<br>backward never.</h2>
                <p class="strength-section__text">I recently competed in my first WRPF powerlifting competition, finishing 2nd overall in my class with a 495kg total. What made it meaningful wasn't the result; it was the journey. The same mindset I bring to the platform, I bring to leadership.</p>
                <div class="strength-section__stats">
                    <div class="strength-section__stat">
                        <span class="strength-section__stat-value">495kg</span>
                        <span class="strength-section__stat-label">Total</span>
                    </div>
                    <div class="strength-section__stat">
                        <span class="strength-section__stat-value">2nd</span>
                        <span class="strength-section__stat-label">Overall</span>
                    </div>
                    <div class="strength-section__stat">
                        <span class="strength-section__stat-value">WRPF</span>
                        <span class="strength-section__stat-label">Great Britain</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include("../partials/latest_posts", {posts: otherArticles}) %>
</main>

<%- include("../partials/footer") %>
<script src="/assets/js/lazysizes.min.js" async></script>
</body>
</html>
