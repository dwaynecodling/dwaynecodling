<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="Description" content="About Dwayne Codling — Development Director, people-first leader, D&I advocate, and powerlifter based in Nottingham.">
    <title>About Me — Dwayne Codling</title>
    <meta property="og:title" content="About Me — Dwayne Codling" />
    <meta property="og:description" content="Development Director. People-first leader. D&I advocate." />
    <meta property="og:image" content="https://dwaynecodling.com/assets/img/pages/dwayne-profile.jpg" />
    <%- include("../partials/links") %>
    <style>
        .about-hero {
            background-image: linear-gradient(to right, rgba(13,26,16,0.97) 0%, rgba(13,26,16,0.6) 100%), url('/assets/img/pages/hero-about-me@720w.jpg');
            background-size: cover;
            background-position: center 33%;
            padding: 10rem 0 8rem;
        }

        @media screen and (min-width: 62em) {
            .about-hero {
                background-image: linear-gradient(to right, rgba(13,26,16,0.97) 0%, rgba(13,26,16,0.6) 100%), url('/assets/img/pages/hero-about-me.jpg');
            }
        }

        .about-intro {
            display: grid;
            gap: 4rem;
            align-items: start;
            margin-bottom: 0;
        }

        @media (min-width: 62em) {
            .about-intro {
                grid-template-columns: 1fr 1.4fr;
                gap: 8rem;
            }
        }

        .about-intro__image {
            position: relative;
        }

        .about-intro__img {
            width: 100%;
            aspect-ratio: 3/4;
            object-fit: cover;
            object-position: center top;
            display: block;
        }

        .about-intro__img-accent {
            position: absolute;
            bottom: -1.2rem;
            right: -1.2rem;
            width: 40%;
            height: 30%;
            border: 2px solid #c8853a;
            z-index: -1;
        }

        .about-intro__label {
            font-size: 1.2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #c8853a;
            margin-bottom: 1.6rem;
        }

        .about-intro__heading {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-2);
            font-weight: 700;
            color: #f4ede0;
            line-height: 1.2;
            margin-bottom: 2.4rem;
        }

        .about-intro__text {
            font-size: 1.7rem;
            line-height: 3rem;
            color: #a89e90;
            margin-bottom: 2rem;
        }

        .about-intro__links {
            display: flex;
            flex-wrap: wrap;
            gap: 1.2rem;
            list-style: none;
            margin-top: 3rem;
        }

        .about-intro__link a {
            display: inline-block;
            font-size: 1.3rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #c8853a;
            border: 1px solid rgba(200,133,58,0.4);
            padding: 0.8rem 1.8rem;
            border-radius: 99px;
            transition: all .2s;
        }

        .about-intro__link a:hover {
            background-color: #c8853a;
            color: #0d1a10;
        }

        .about-intro__link a:after { display: none; }

        /* Story section */
        .about-story {
            max-width: 74rem;
            margin: 0 auto;
        }

        .about-story__heading {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-3);
            font-weight: 700;
            color: #f4ede0;
            margin-bottom: 1.6rem;
            margin-top: 5rem;
            padding-top: 4rem;
            border-top: 1px solid rgba(200,133,58,0.15);
        }

        .about-story__heading:first-child {
            margin-top: 0;
            padding-top: 0;
            border-top: none;
        }

        .about-story__text {
            font-size: 1.7rem;
            line-height: 3.2rem;
            color: #a89e90;
            margin-bottom: 2rem;
        }

        .about-story__quote {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 2.2rem;
            font-style: italic;
            color: #c8853a;
            border-left: 3px solid #c8853a;
            padding-left: 2.4rem;
            margin: 4rem 0;
            line-height: 1.5;
        }

        /* People grid */
        .people-section {
            margin-bottom: 10rem;
        }

        .people-section__label {
            font-size: 1.2rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #c8853a;
            margin-bottom: 1.6rem;
        }

        .people-section__heading {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: var(--heading-2);
            font-weight: 700;
            color: #f4ede0;
            margin-bottom: 4rem;
            max-width: 52rem;
        }

        .people-grid {
            display: grid;
            gap: 2rem;
            grid-template-columns: 1fr;
        }

        @media (min-width: 48em) {
            .people-grid {
                grid-template-columns: 1.2fr 1fr;
                grid-template-rows: auto auto;
            }

            .people-grid__item--tall {
                grid-row: span 2;
            }
        }

        .people-grid__item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            min-height: 28rem;
        }

        @media (min-width: 48em) {
            .people-grid__item--tall img {
                min-height: 52rem;
            }
            .people-grid__item:not(.people-grid__item--tall) img {
                min-height: 24rem;
            }
        }

        /* Fitness reel section */
        .fitness-section {
            display: grid;
            gap: 4rem;
            align-items: start;
            margin-top: 5rem;
        }

        @media (min-width: 62em) {
            .fitness-section {
                grid-template-columns: 1.4fr 1fr;
                gap: 6rem;
            }
        }

        .fitness-reel {
            position: relative;
            min-height: 48rem;
            border-radius: 3px;
            background: linear-gradient(90deg, #162419 25%, #1e3224 50%, #162419 75%);
            background-size: 200% 100%;
            animation: reel-shimmer 1.5s ease-in-out infinite;
        }

        @keyframes reel-shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        .fitness-reel__accent {
            position: absolute;
            bottom: -1.2rem;
            left: -1.2rem;
            width: 12rem;
            height: 12rem;
            border: 2px solid #c8853a;
            z-index: -1;
        }
    </style>
</head>
<body>
<%- include("../partials/nav") %>

<main id="main-content" class="content" role="main">

    <!-- Page Hero -->
    <section style="margin-bottom:0;">
        <div class="about-hero">
            <div class="container">
                <p style="font-size:1.2rem; font-weight:600; text-transform:uppercase; letter-spacing:0.2em; color:#c8853a; margin-bottom:1.6rem;">About me</p>
                <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:var(--heading-1); font-weight:700; color:#f4ede0; line-height:1.15; max-width:56rem; margin-bottom:2rem;">
                    People-first leader.<br>Always learning.
                </h1>
                <p style="font-size:1.8rem; line-height:3rem; color:rgba(244,237,224,0.75); max-width:52rem;">
                    Development Director from Nottingham, originally from Jamaica. Over a decade building teams, bridging gaps, and trying to leave things better than I found them.
                </p>
            </div>
        </div>
    </section>

    <!-- Intro with photo -->
    <section style="padding-top: 6rem;">
        <div class="container">
            <div class="about-intro">
                <div class="about-intro__image">
                    <img class="about-intro__img" src="/assets/img/pages/dwayne-profile.jpg" alt="Dwayne Codling" />
                    <div class="about-intro__img-accent"></div>
                </div>
                <div class="about-intro__body">
                    <p class="about-intro__label">Development Director</p>
                    <h2 class="about-intro__heading">Building teams that perform, and people who grow.</h2>
                    <p class="about-intro__text">
                        I've grown from frontend developer to director-level leader across some of the UK's leading digital agencies. Most recently at IDHL, I helped unite five separate development agencies into one cohesive, high-performing team.
                    </p>
                    <p class="about-intro__text">
                        What drives me isn't the org chart; it's the people. Watching someone step into their potential, seeing a team click into gear, building a culture where people actually want to show up. That's what I'm here for.
                    </p>
                    <p class="about-intro__text">
                        I'm currently open to my next leadership role where I can drive real impact.
                    </p>
                    <ul class="about-intro__links">
                        <li class="about-intro__link"><a href="#story">My story</a></li>
                        <li class="about-intro__link"><a href="#inclusion">D&I work</a></li>
                        <li class="about-intro__link"><a href="#people">People first</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Story -->
    <section>
        <div class="container">
            <div class="about-story">

                <h3 id="story" class="about-story__heading">How did you get here?</h3>
                <p class="about-story__text">It started at university on a Multimedia course, where I discovered web design and development almost by accident. That curiosity never left. Over the years I built things, taught things, and grew more confident in both my craft and my ability to share it.</p>
                <p class="about-story__text">I spent four years as a Lecturer in Media at New College Nottingham, teaching students real-world frontend skills while running freelance projects on the side. Watching a student land their first industry job? That doesn't get old.</p>

                <h3 class="about-story__heading">The move into agency life</h3>
                <p class="about-story__text">I made the move into full-time agency development at JH in Nottingham, growing from frontend developer to Pod Lead, managing a team delivering large-scale eCommerce builds. That leadership role opened a door I didn't know I was walking toward. I discovered I was just as energised by developing people as I was by developing software.</p>

                <h3 class="about-story__heading">The IDHL chapter</h3>
                <p class="about-story__text">At IDHL I served first as Head of Development at Pinpoint, then as Development Director across the group. The brief: take five separate agencies, each with its own culture, and build one unified team. We established performance review structures, cross-team training programmes, and sustainable ways of working.</p>
                <p class="about-story__text">One highlight I'm proud of: a training initiative that helped Adobe Commerce developers upskill into Shopify, unlocking new career paths and expanding capability across the business.</p>

                <h3 id="inclusion" class="about-story__heading">Diversity &amp; Inclusion</h3>
                <p class="about-story__text">This matters to me personally. I've spoken at Tech Nottingham, Drink Digital, HackSoc, and allyship events in Leeds. My view is simple: if we build products for a diverse world but refuse to invest in diverse talent, we're failing everyone.</p>
                <p class="about-story__text">I've also advised ProjectFunction, a programme creating pathways into tech for underrepresented groups. If I can help one person find their way in who might not have otherwise, that's a legacy worth having.</p>

                <div class="about-story__quote">
                    "Forward ever, backward never."
                </div>

                <h3 class="about-story__heading">Beyond work</h3>
                <p class="about-story__text">I'm a dad first. I do the school runs, read in class with the kids, show up at sports days. Family isn't something I fit around work; it's the reason I take my work seriously.</p>
                <p class="about-story__text">I also compete in raw powerlifting. In March 2026 I entered my first WRPF competition and finished 2nd in my class with a 495kg total. Training taught me something I already believed but needed to live: setbacks are part of the process. How you respond defines the outcome.</p>

                <div class="fitness-section">
                    <div>
                        <p class="about-intro__label">Fitness</p>
                        <h3 class="about-story__heading" style="margin-top:0; padding-top:0; border-top:none;">Training outside the office.</h3>
                        <p class="about-story__text">Follow along on Instagram for updates from the platform, competition prep, and the ongoing journey.</p>
                        <a href="https://www.instagram.com/dwaynecodling.fitness"
                           class="hero__button hero__button--outline"
                           style="margin-top: 3rem; display: inline-flex;"
                           target="_blank"
                           rel="noopener noreferrer">
                            Follow the fitness journey
                        </a>
                    </div>
                    <div class="fitness-reel">
                        <blockquote class="instagram-media"
                            data-instgrm-permalink="https://www.instagram.com/reel/DWl50ZECEhA/"
                            data-instgrm-version="14"
                            style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); max-width:100%; min-width:326px; width:100%; padding:0; margin:0;">
                        </blockquote>
                        <div class="fitness-reel__accent"></div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- People First photo section -->
    <section id="people">
        <div class="container">
            <div class="people-section">
                <p class="people-section__label">People first</p>
                <h2 class="people-section__heading">The best work happens when people feel valued.</h2>
                <div class="people-grid">
                    <div class="people-grid__item people-grid__item--tall">
                        <img src="/assets/img/pages/dwayne-community-1.jpg" alt="Dwayne with his team at a community event" loading="lazy" />
                    </div>
                    <div class="people-grid__item">
                        <img src="/assets/img/pages/dwayne-community-2.jpg" alt="Dwayne and colleagues at a team event" loading="lazy" />
                    </div>
                    <div class="people-grid__item">
                        <img src="/assets/img/pages/dwayne-bw.jpg" alt="Dwayne Codling" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

<%- include("../partials/footer") %>
<script src="/assets/js/lazysizes.min.js" async></script>
<script async src="//www.instagram.com/embed.js"></script>
</body>
</html>
